{
  "name": "@maksimkurb/lens-better-logs-plugin",
  "version": "0.2.3",
  "description": "Replaces the built-in pod logs list in Lens / OpenLens / Freelens with a Monaco editor: select and copy across the whole log, no UI bleed.",
  "author": "Maksim Kurb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maksimkurb/lens-better-logs-reader.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "engines": {
    "freelens": "^2.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "lens",
    "openlens",
    "freelens",
    "extension",
    "kubernetes",
    "logs"
  ],
  "devDependencies": {
    "@freelensapp/extensions": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "mobx": "^7.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
